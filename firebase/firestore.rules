rules_version = '2';

// Firestore Security Rules for Smart Inventory System
//
// These rules are the REAL access control layer -- they matter even
// though the Flask backend also checks auth, because Firestore can
// also be read directly from the frontend in some cases, and because
// defense-in-depth means the database itself shouldn't trust the API
// layer alone.
//
// To apply these rules:
//   1. Firebase Console -> Firestore Database -> Rules tab
//   2. Paste this file's contents, replacing the test-mode rules
//   3. Click "Publish"
//
// This replaces the temporary "test mode" (open to anyone) rules that
// expire 30 days after project creation.

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their OWN profile document.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // profiles are never deleted by clients
    }

    // Products: any signed-in vendor can read/write products.
    // (Multi-tenant isolation between different shops is a possible
    // future enhancement -- for this project, all signed-in vendors
    // share one inventory space, matching a single-shop deployment.)
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Vendors (supplier records, not the same as shop-owner users)
    match /vendors/{vendorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Inventory activity logs -- written by the backend, readable by
    // any signed-in user for the Activity Timeline feature.
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
