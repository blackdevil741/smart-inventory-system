# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-in-production
PORT=5000

# CORS - comma separated list of allowed origins (your frontend URLs)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Firebase Admin SDK
# Path to the service account JSON key (downloaded from Firebase Console
# -> Project Settings -> Service Accounts -> Generate New Private Key)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Firebase project config (used to build resource URLs, e.g. Storage bucket)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
